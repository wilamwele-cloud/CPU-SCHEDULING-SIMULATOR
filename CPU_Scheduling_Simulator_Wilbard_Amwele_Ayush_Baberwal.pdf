          }) Tj T* (        }) Tj T* (    }) Tj T*  T* (    wt[0] = 0;) Tj T* (    for \(i = 1; i < n; i++\)) Tj T* (        wt[i] = wt[i - 1] + bt[i - 1];) Tj T*  T* (    for \(i = 0; i < n; i++\)) Tj T* (        tat[i] = wt[i] + bt[i];) Tj T*  T* (    printf\("\\nProcess\\tPriority\\tBT\\tWT\\tTAT\\n"\);) Tj T* (    for \(i = 0; i < n; i++\)) Tj T* (        printf\("P%d\\t%d\\t\\t%d\\t%d\\t%d\\n",) Tj T* (               p[i], pr[i], bt[i], wt[i], tat[i]\);) Tj T* (}) Tj T*  T* (void multiLevelQueue\(\) {) Tj T* (    int n, i, bt[MAX], q[MAX], p[MAX];) Tj T*  T* (    printf\("\\n--- Multi-Level Queue Scheduling ---\\n"\);) Tj T* (    printf\("Enter number of processes: "\);) Tj T* (    scanf\("%d", &n\);) Tj T*  T* (    for \(i = 0; i < n; i++\) {) Tj T* (        printf\("Enter Burst Time and Queue \(0=High, 1=Low\) for P%d: ",) Tj T* (               i + 1\);) Tj T* (        scanf\("%d%d", &bt[i], &q[i]\);) Tj T* (        p[i] = i + 1;) Tj T* (    }) Tj T* ET
