BT 1 0 0 1 6 627.4 Tm /F3 7.4 Tf 9.2 TL (#include <stdio.h>) Tj T* (#include <stdlib.h>) Tj T*  T* (#define MAX 100) Tj T*  T* (void fcfs\(\) {) Tj T* (    int n, i, bt[MAX], wt[MAX], tat[MAX];) Tj T* (    printf\("\\n--- FCFS Scheduling ---\\n"\);) Tj T* (    printf\("Enter number of processes: "\);) Tj T* (    scanf\("%d", &n\);) Tj T*  T* (    for \(i = 0; i < n; i++\) {) Tj T* (        printf\("Enter Burst Time for P%d: ", i + 1\);) Tj T* (        scanf\("%d", &bt[i]\);) Tj T* (    }) Tj T*  T* (    wt[0] = 0;) Tj T* (    for \(i = 1; i < n; i++\)) Tj T* (        wt[i] = wt[i - 1] + bt[i - 1];) Tj T*  T* (    for \(i = 0; i < n; i++\)) Tj T* (        tat[i] = wt[i] + bt[i];) Tj T*  T* (    printf\("\\nProcess\\tBT\\tWT\\tTAT\\n"\);) Tj T* (    for \(i = 0; i < n; i++\)) Tj T* (        printf\("P%d\\t%d\\t%d\\t%d\\n", i + 1, bt[i], wt[i], tat[i]\);) Tj T* (}) Tj T*  T* (void sjf\(\) {) Tj T* (    int n, i, j, bt[MAX], p[MAX], wt[MAX], tat[MAX], temp;) Tj T*  T* (    printf\("\\n--- SJF Scheduling ---\\n"\);) Tj T* (    printf\("Enter number of processes: "\);) Tj T* (    scanf\("%d", &n\);) Tj T*  T* (    for \(i = 0; i < n; i++\) {) Tj T* (        printf\("Enter Burst Time for P%d: ", i + 1\);) Tj T* (        scanf\("%d", &bt[i]\);) Tj T* (        p[i] = i + 1;) Tj T* (    }) Tj T*  T* (    for \(i = 0; i < n - 1; i++\) {) Tj T* (        for \(j = i + 1; j < n; j++\) {) Tj T* (            if \(bt[i] > bt[j]\) {) Tj T* (                temp = bt[i]; bt[i] = bt[j]; bt[j] = temp;) Tj T* (                temp = p[i]; p[i] = p[j]; p[j] = temp;) Tj T* (            }) Tj T* (        }) Tj T* (    }) Tj T*  T* (    wt[0] = 0;) Tj T* (    for \(i = 1; i < n; i++\)) Tj T* (        wt[i] = wt[i - 1] + bt[i - 1];) Tj T*  T* (    for \(i = 0; i < n; i++\)) Tj T* (        tat[i] = wt[i] + bt[i];) Tj T*  T* (    printf\("\\nProcess\\tBT\\tWT\\tTAT\\n"\);) Tj T* (    for \(i = 0; i < n; i++\)) Tj T* (        printf\("P%d\\t%d\\t%d\\t%d\\n", p[i], bt[i], wt[i], tat[i]\);) Tj T* (}) Tj T*  T* (void roundRobin\(\) {) Tj T* (    int n, tq, i, time = 0, done;) Tj T* (    int bt[MAX], rt[MAX];) Tj T*  T* (    printf\("\\n--- Round Robin Scheduling ---\\n"\);) Tj T* (    printf\("Enter number of processes: "\);) Tj T* (    scanf\("%d", &n\);) Tj T* ET
